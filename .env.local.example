# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...

# App
NEXT_PUBLIC_APP_URL=https://thinkbig.webtek.ai

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/think-big-growth?retryWrites=true&w=majority&appName=Cluster0

# JWT — generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Resend — sign up at resend.com, verify thinkbig.webtek.ai domain
RESEND_API_KEY=re_...

# Cron security secret — any strong random string
CRON_SECRET=
